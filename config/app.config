# Default configuration file for the miarka  processing service
---

port: 9999
db_connection_string: sqlite:///miarka_processing.db
monitored_directories:
    - ./tests/resources
# Logging config passed to Alembic during migrations — routes migration output
# through the same handlers (file rotation, formatter) as the application
alembic_log_config_path: config/logger.config
alembic_scripts: ./alembic/


